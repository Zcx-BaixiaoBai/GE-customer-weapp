# ========== 环境配置 ==========
# 生产环境务必设为 production
NODE_ENV=development

# 服务端口
PORT=3001

# 微信小程序配置
# 获取地址：https://mp.weixin.qq.com → 开发管理 → 开发设置
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# JWT配置
# 生产环境必须用强随机串（至少32字符）：
#   生成命令: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jinying_property

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# FastGPT
FASTGPT_BASE_URL=http://localhost:3000/api/v1
FASTGPT_API_KEY=your_fastgpt_api_key

# 报修字段提取 LLM（通用OpenAI兼容接口）
# 优先级：此配置 > FastGPT（直连LLM更快）
# 兼容通义千问/DeepSeek/智谱GLM/OpenAI/Kimi等
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=qwen-max
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=15000

# 腾讯云ASR (一句话识别)
TENCENT_CLOUD_SECRET_ID=your_secret_id
TENCENT_CLOUD_SECRET_KEY=your_secret_key

# MinIO对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=fastgpt_minio
MINIO_SECRET_KEY=fastgpt_minio_secret_2026
MINIO_BUCKET=jinying-repair

# 工单系统API
WORK_ORDER_API_URL=https://pms-api.jinying.com/api
WORK_ORDER_API_KEY=your_work_order_api_key
