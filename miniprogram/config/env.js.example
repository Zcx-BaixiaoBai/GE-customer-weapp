// 环境配置模板：复制本文件为 env.js 后填写（env.js 已 gitignore，密钥永不入库）
// cp miniprogram/config/env.js.example miniprogram/config/env.js
var ENV = {
  dev: {
    // 真机调试用电脑局域网IP，开发者工具也可以用这个IP
    // 注意：IP会随WiFi网络变化，真机连不上时先ipconfig确认当前IP
    API_BASE_URL: 'http://127.0.0.1:3001/api',
    FASTGPT_BASE_URL: 'http://127.0.0.1:3000/api/v1',
    FASTGPT_API_KEY: '',   // FastGPT 后台「应用 → API 密钥」生成
    FASTGPT_APP_ID: '',
    PMS_API: 'https://pms-api.jinying.com/api',
    PMS_COUNTER_ID: ''
  },
  prod: {
    API_BASE_URL: 'https://api.example.com/api',
    FASTGPT_BASE_URL: 'https://ai.example.com/api/v1',
    FASTGPT_API_KEY: '',
    FASTGPT_APP_ID: '',
    PMS_API: 'https://pms-api.jinying.com/api',
    PMS_COUNTER_ID: ''
  },
  tunnel: {
    // Cloudflare 临时隧道（cloudflared trycloudflare）示例
    API_BASE_URL: 'https://<your-tunnel>.trycloudflare.com/api',
    FASTGPT_BASE_URL: 'https://<your-tunnel>.trycloudflare.com/ai/api/v1',
    FASTGPT_API_KEY: '',
    FASTGPT_APP_ID: '',
    PMS_API: 'https://pms-api.jinying.com/api',
    PMS_COUNTER_ID: ''
  }
};

var CURRENT_ENV = 'dev';

module.exports = {
  config: ENV[CURRENT_ENV]
};
