/* 考试列表 — 编辑式页首 + 分组列表 */
.exam-list-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 48rpx;
}

/* 页首：眉题 + 大标题 + 右侧链接 */
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 48rpx 40rpx 32rpx;
}
.header-text {
  display: flex;
  flex-direction: column;
}
.page-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #86868b;
  display: block;
  margin-bottom: 16rpx;
}
.page-title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.15;
  color: #1d1d1f;
  display: block;
}
.history-link {
  font-size: 26rpx;
  color: #0066cc;
  padding-bottom: 8rpx;
}
.history-link:active { opacity: 0.6; }

.loading-wrap {
  margin: 0 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
}
.empty-wrap {
  display: flex; align-items: center; justify-content: center; height: 400rpx;
}
.empty-text { font-size: 26rpx; color: #86868b; }

/* 骨架屏：紫 chip 占位 + 两行文字 */
.sk-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}
.sk-chip {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.sk-lines {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}
.sk-line {
  height: 26rpx;
  margin-bottom: 14rpx;
}
.sk-line:last-child {
  margin-bottom: 0;
}

/* 分组容器 */
.exam-group {
  margin: 0 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
}

.exam-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  position: relative;
  transition: background 0.15s ease;
}
.exam-row:active {
  background: #f5f5f7;
}
.exam-row::after {
  content: '';
  position: absolute;
  left: 160rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #d2d2d7;
  transform: scaleY(0.5);
}
.exam-row.last::after {
  display: none;
}

/* 紫色图标 chip（考试 = #af52de） */
.exam-chip {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #af52de;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.exam-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.exam-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #1d1d1f;
  display: block;
  margin-bottom: 8rpx;
}
.exam-meta {
  display: flex;
  align-items: center;
}
.meta-item {
  font-size: 22rpx;
  color: #86868b;
}

.chevron {
  font-size: 44rpx;
  color: #c7c7cc;
  margin-left: 16rpx;
  line-height: 1;
}
