.training-detail-page {
  min-height: 100vh;
  background: #f5f5f7;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.loading-text { font-size: 26rpx; color: #86868b; }

.content-section {
  width: 100%;
  background: #000000;
}
.training-video {
  width: 100%;
  height: 420rpx;
}
.article-content {
  background: #ffffff;
  padding: 32rpx;
  min-height: 400rpx;
}
.rich-text-content {
  font-size: 30rpx;
  color: #1d1d1f;
  line-height: 1.8;
}
/* 「标记为已读完」胶囊按钮 */
.article-read-complete {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  text-align: center;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 980rpx;
  font-size: 30rpx;
  color: #0071e3;
}
.article-read-complete:active {
  background: rgba(0, 113, 227, 0.16);
}
.no-video {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.no-video-text { color: #86868b; font-size: 26rpx; }

.course-header {
  background: #ffffff;
  padding: 36rpx 32rpx;
}
.course-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #1d1d1f;
  display: block;
  margin-bottom: 12rpx;
}
.course-desc {
  font-size: 26rpx;
  line-height: 1.35;
  color: #6e6e73;
  display: block;
}

.lesson-list {
  margin-top: 24rpx;
  background: #ffffff;
  padding: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #1d1d1f;
  margin-bottom: 24rpx;
}

.lesson-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d2d2d7;
}
.lesson-item:last-child { border-bottom: none; }
.lesson-item:active { opacity: 0.85; }
.lesson-item.active {
  background: rgba(0, 113, 227, 0.08);
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.lesson-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f7;
  color: #6e6e73;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.lesson-item.active .lesson-index {
  background: #0071e3;
  color: #ffffff;
}

.lesson-info { flex: 1; }
.lesson-title {
  font-size: 30rpx;
  color: #1d1d1f;
  display: block;
  margin-bottom: 6rpx;
}
.lesson-meta { display: flex; }
.lesson-progress-text {
  font-size: 22rpx;
  color: #34c759;
}
.lesson-progress-text.unstarted { color: #86868b; }

.lesson-status { margin-left: 16rpx; }
.completed-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* CSS 绘制勾号 */
.checkmark {
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* 课时类型徽标：语义色 10% 底 + 语义色文字，胶囊 */
.lesson-type-tag {
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 980rpx;
  flex-shrink: 0;
}
.tag-video {
  background: rgba(0, 113, 227, 0.08);
  color: #0071e3;
}
.tag-article {
  background: rgba(52, 199, 89, 0.1);
  color: #34c759;
}

/* AI培训助手入口 */
.ai-assistant-btn {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 48rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
}
.ai-assistant-btn:active { opacity: 0.85; }
.ai-assistant-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #0071e3;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 24rpx;
}
.ai-icon-text { font-size: 24rpx; color: #ffffff; font-weight: 600; }
.ai-assistant-text { flex: 1; }
.ai-assistant-title {
  font-size: 30rpx; color: #1d1d1f; font-weight: 600;
  display: block; margin-bottom: 4rpx;
}
.ai-assistant-desc { font-size: 24rpx; color: #86868b; }
.ai-assistant-arrow { font-size: 36rpx; color: #86868b; }
