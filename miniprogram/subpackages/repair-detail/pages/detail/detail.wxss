/* 报修详情 — Apple 设计体系（见根目录 DESIGN.md） */

.detail-container {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx 32rpx;
}

/* 卡片：白底、24rpx 圆角、无描边、无阴影 */
.detail-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 12rpx 36rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
}
.detail-row-desc {
  flex-direction: column;
}
.detail-row-desc .detail-value {
  text-align: left;
  margin-top: 12rpx;
  line-height: 1.5;
}
.detail-label {
  font-size: 26rpx;
  color: #86868b;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.detail-value {
  font-size: 30rpx;
  color: #1d1d1f;
  text-align: right;
  word-break: break-word;
}

.detail-photos {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.detail-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
}

.detail-empty {
  text-align: center;
  padding: 160rpx 0;
  font-size: 30rpx;
  color: #86868b;
}

/* 状态文字：Apple 语义色 */
.text-warning { color: #ff9500; }
.text-success { color: #34c759; }
.text-processing { color: #0071e3; }

.detail-loading {
  text-align: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 26rpx;
  color: #86868b;
}
