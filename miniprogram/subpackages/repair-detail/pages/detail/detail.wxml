<view class="detail-container">

  <view class="detail-loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="detail-card" wx:if="{{!loading && detail}}">
    <view class="detail-row">
      <text class="detail-label">工单号</text>
      <text class="detail-value">{{detail.q_id}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">状态</text>
      <text class="detail-value {{detail.status === '待处理' ? 'text-warning' : detail.status === '已完成' ? 'text-success' : 'text-processing'}}">{{detail.status}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">报修类型</text>
      <text class="detail-value">{{detail.type}}</text>
    </view>
    <view class="detail-row detail-row-desc">
      <text class="detail-label">问题描述</text>
      <text class="detail-value">{{detail.content}}</text>
    </view>
    <view class="detail-row" wx:if="{{detail.prj}}">
      <text class="detail-label">项目</text>
      <text class="detail-value">{{detail.prj}}</text>
    </view>
    <view class="detail-row" wx:if="{{detail.brand}}">
      <text class="detail-label">铺位</text>
      <text class="detail-value">{{detail.counter}} | {{detail.brand}}</text>
    </view>
    <view class="detail-row" wx:if="{{detail.workerName}}">
      <text class="detail-label">维修人</text>
      <text class="detail-value">{{detail.workerName}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">联系电话</text>
      <text class="detail-value">{{detail.phone}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">提交时间</text>
      <text class="detail-value">{{detail.createTime}}</text>
    </view>
    <view class="detail-row" wx:if="{{photos.length > 0}}">
      <text class="detail-label">现场照片</text>
      <view class="detail-photos">
        <image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill"
               class="detail-photo" data-url="{{item}}" bindtap="previewPhoto" />
      </view>
    </view>
  </view>

  <view class="detail-empty" wx:if="{{!loading && !detail}}">
    <text>未找到报修记录</text>
  </view>

</view>
