/* 我的报修列表 — Apple 设计体系（见根目录 DESIGN.md） */

.list-container {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 0 32rpx 32rpx;
}

/* 页首：眉题 + 大标题 */
.page-header {
  padding: 48rpx 8rpx 32rpx;
}
.page-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #86868b;
  display: block;
  margin-bottom: 16rpx;
}
.page-title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.15;
  color: #1d1d1f;
  display: block;
}

.list-loading {
  padding: 8rpx 0;
}

/* 骨架屏卡片 */
.sk-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}
.sk-line {
  height: 28rpx;
  margin-bottom: 20rpx;
}
.sk-line:last-child {
  margin-bottom: 0;
}

.list-empty {
  text-align: center;
  padding: 160rpx 0;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #86868b;
  font-size: 44rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
}
.empty-sub {
  font-size: 26rpx;
  color: #86868b;
  display: block;
  margin-top: 12rpx;
}

/* 列表：iOS 分组容器 + 细线分隔，非悬浮卡 */
.repair-list {
  margin: 8rpx 0 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
}
.repair-item {
  padding: 28rpx 32rpx;
  position: relative;
  transition: background 0.15s ease;
}
.repair-item::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #d2d2d7;
  transform: scaleY(0.5);
}
.repair-item:last-child::after {
  display: none;
}
.repair-item:active {
  background: #f5f5f7;
}
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.item-type {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  color: #1d1d1f;
}

/* 状态徽标：胶囊 + 语义色 10% 底 */
.item-status {
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 20rpx;
  border-radius: 980rpx;
}
.status-pending {
  background: rgba(255, 149, 0, 0.1);
  color: #ff9500;
}
.status-processing {
  background: rgba(0, 113, 227, 0.08);
  color: #0071e3;
}
.status-done {
  background: rgba(52, 199, 89, 0.1);
  color: #34c759;
}

.item-desc {
  font-size: 30rpx;
  line-height: 1.5;
  color: #6e6e73;
  display: block;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-location {
  font-size: 26rpx;
  color: #6e6e73;
}
.item-time {
  font-size: 22rpx;
  color: #86868b;
}
