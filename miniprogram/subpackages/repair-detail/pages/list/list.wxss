.list-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.list-loading {
  text-align: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #8a95a7;
}

.list-empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e8ebf0;
  color: #c4cbd7;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #8a95a7;
  display: block;
}
.empty-sub {
  font-size: 24rpx;
  color: #c4cbd7;
  display: block;
  margin-top: 8rpx;
}

.repair-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.item-type {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.item-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}
.status-pending {
  background: #fff7e6;
  color: #f79009;
}
.status-processing {
  background: #e6f0ff;
  color: #185fa5;
}
.status-done {
  background: #e6fffa;
  color: #00b578;
}
.item-desc {
  font-size: 28rpx;
  color: #485264;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-footer {
  display: flex;
  justify-content: space-between;
}
.item-location {
  font-size: 24rpx;
  color: #8a95a7;
}
.item-time {
  font-size: 24rpx;
  color: #c4cbd7;
}
