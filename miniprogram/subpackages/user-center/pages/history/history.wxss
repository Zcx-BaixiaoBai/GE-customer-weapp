/* 问答历史 — Apple 设计体系（见根目录 DESIGN.md） */

.history-container {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx 32rpx;
}
.history-empty {
  text-align: center;
  padding: 160rpx 0;
  color: #86868b;
  font-size: 30rpx;
}

/* 卡片：白底、24rpx 圆角、无描边、无阴影 */
.history-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.history-item:active {
  opacity: 0.7;
}
.history-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  color: #1d1d1f;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-time {
  font-size: 22rpx;
  color: #86868b;
}
