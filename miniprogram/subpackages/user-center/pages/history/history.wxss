.history-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}
.history-empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 30rpx;
}
.history-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.history-title {
  font-size: 32rpx;
  color: #1a1a2e;
  display: block;
  margin-bottom: 12rpx;
}
.history-time {
  font-size: 26rpx;
  color: #999999;
}
