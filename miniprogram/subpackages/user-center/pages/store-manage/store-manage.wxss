.sm-container { padding: 24rpx; min-height: 100vh; background: #f5f5f7; }
.empty { text-align: center; color: #86868b; font-size: 26rpx; padding: 80rpx 0; }
.empty.small { padding: 24rpx; }
.retry-btn { display: inline-block; margin-top: 24rpx; padding: 16rpx 48rpx; background: #0071e3; color: #fff; border-radius: 12rpx; font-size: 26rpx; }

.sm-header { padding: 24rpx 8rpx 16rpx; }
.sm-title { display: block; font-size: 40rpx; font-weight: 700; color: #1d1d1f; }
.sm-sub { display: block; font-size: 24rpx; color: #86868b; margin-top: 12rpx; }

.stat-grid { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-box { flex: 1; background: #fff; border-radius: 16rpx; padding: 28rpx 0; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.stat-num { display: block; font-size: 44rpx; font-weight: 700; color: #0071e3; }
.stat-box.green .stat-num { color: #34c759; }
.stat-box.orange .stat-num { color: #ff9500; }
.stat-label { display: block; font-size: 22rpx; color: #86868b; margin-top: 8rpx; }

.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.card-title { display: block; font-size: 30rpx; font-weight: 600; color: #1d1d1f; margin-bottom: 20rpx; }

.req-list { display: flex; flex-direction: column; gap: 16rpx; }
.req-item { display: flex; align-items: center; gap: 16rpx; }
.req-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; color: #fff; }
.req-tag.course { background: #0071e3; }
.req-tag.exam { background: #af52de; }
.req-name { font-size: 26rpx; color: #1d1d1f; }

.emp-table { width: 100%; }
.emp-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #f2f2f7; }
.emp-row:last-child { border-bottom: none; }
.emp-head { border-bottom: 2rpx solid #e5e5ea; }
.emp-head text { font-size: 22rpx; color: #86868b; font-weight: 600; }
.emp-name { flex: 1.4; display: flex; flex-direction: column; }
.emp-phone { font-size: 26rpx; color: #1d1d1f; font-weight: 500; }
.emp-pos { font-size: 20rpx; color: #86868b; margin-top: 4rpx; }
.emp-course { flex: 1; font-size: 26rpx; color: #1d1d1f; text-align: center; }
.emp-exam { flex: 1; font-size: 26rpx; color: #1d1d1f; text-align: center; }
.emp-status { flex: 1; font-size: 24rpx; text-align: center; }
.emp-status.done { color: #34c759; font-weight: 600; }
.emp-status.not { color: #ff3b30; }

.tip { font-size: 22rpx; color: #86868b; line-height: 1.6; padding: 8rpx; }
