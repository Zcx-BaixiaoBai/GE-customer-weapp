{
  "pages": [
    "pages/index/index",
    "pages/chat/chat",
    "pages/repair/repair",
    "pages/profile/profile",
    "pages/tenant-select/tenant-select",
    "pages/privacy/privacy"
  ],
  "subpackages": [
    {
      "root": "subpackages/user-center",
      "name": "user-center",
      "pages": [
        "pages/history/history",
        "pages/store-manage/store-manage"
      ]
    },
    {
      "root": "subpackages/repair-detail",
      "name": "repair-detail",
      "pages": [
        "pages/list/list",
        "pages/detail/detail"
      ]
    },
    {
      "root": "subpackages/training",
      "name": "training",
      "pages": [
        "pages/list/list",
        "pages/detail/detail",
        "pages/assistant/assistant"
      ]
    },
    {
      "root": "subpackages/exam",
      "name": "exam",
      "pages": [
        "pages/list/list",
        "pages/take/take",
        "pages/result/result",
        "pages/certificates/certificates"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["user-center"]
    },
    "pages/repair/repair": {
      "network": "wifi",
      "packages": ["repair-detail"]
    }
  },
  "window": {
    "navigationBarTitleText": "金鹰世界",
    "navigationBarBackgroundColor": "#f5f5f7",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f5f7",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#86868b",
    "selectedColor": "#0071e3",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/repair/repair",
        "text": "报修"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "个人中心"
      }
    ]
  },
  "permission": {
    "scope.record": {
      "desc": "用于语音描述报修问题"
    },
    "scope.camera": {
      "desc": "用于拍摄报修现场照片"
    }
  },
  "requiredPrivateInfos": ["chooseLocation"],
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
