/* 智能问答 — Apple 设计体系 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #f5f5f7;
  flex-shrink: 0;
}
.chat-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}
.chat-new-btn {
  font-size: 26rpx;
  color: #0066cc;
  padding: 10rpx 28rpx;
  border: 1rpx solid #0066cc;
  border-radius: 980rpx;
}
.chat-new-btn:active {
  background: rgba(0, 113, 227, 0.06);
}

.msg-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}
.msg-item {
  margin-bottom: 36rpx;
  animation: fadeUp 0.3s cubic-bezier(0.2, 0, 0, 1);
}

.msg-system {
  text-align: center;
  padding: 24rpx;
}
.msg-system text {
  font-size: 22rpx;
  color: #86868b;
  background: rgba(0, 0, 0, 0.04);
  padding: 12rpx 28rpx;
  border-radius: 980rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}
.msg-row-user {
  justify-content: flex-end;
}
.msg-row-assistant {
  justify-content: flex-start;
}

/* AI 头像：纯黑圆，禁渐变 */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1d1d1f;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.msg-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 78%;
}

/* 用户气泡：Apple 蓝 */
.msg-bubble-user {
  max-width: 100%;
  background: #0071e3;
  color: #ffffff;
  padding: 20rpx 28rpx;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
}

/* AI 气泡：白底无阴影 */
.msg-bubble-ai {
  max-width: 100%;
  background: #ffffff;
  color: #1d1d1f;
  padding: 20rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
}
.msg-cursor {
  display: inline;
  color: #0071e3;
  animation: blink 1s infinite;
}
@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.thinking-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
}
.thinking-status text {
  font-size: 26rpx;
  color: #86868b;
}
.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  background: #86868b;
  border-radius: 50%;
  animation: thinking 1.4s infinite ease-in-out both;
}
.thinking-dot:nth-child(2) { animation-delay: 0.2s; }
.thinking-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes thinking {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 思考过程 */
.reasoning-wrap {
  margin-top: 12rpx;
  max-width: 100%;
}
.reasoning-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 980rpx;
}
.reasoning-label {
  font-size: 22rpx;
  color: #86868b;
  font-weight: 400;
}
.reasoning-arrow {
  font-size: 20rpx;
  color: #86868b;
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.reasoning-arrow.expanded {
  transform: rotate(270deg);
}
.reasoning-content {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
}
.reasoning-content text {
  font-size: 24rpx;
  color: #6e6e73;
  line-height: 1.5;
}

/* 回答来源 */
.sources-wrap {
  margin-top: 16rpx;
  width: 100%;
}
.sources-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 980rpx;
}
.sources-label {
  font-size: 24rpx;
  color: #0066cc;
  font-weight: 400;
}
.sources-arrow {
  font-size: 22rpx;
  color: #0066cc;
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.sources-arrow.expanded {
  transform: rotate(270deg);
}
.sources-list {
  margin-top: 12rpx;
}
.source-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}
.source-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1d1d1f;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.source-content {
  flex: 1;
}
.source-name {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}
.source-snippet {
  font-size: 24rpx;
  color: #86868b;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 输入区 */
.chat-input-area {
  display: flex;
  padding: 12rpx 24rpx;
  background: #f5f5f7;
  flex-shrink: 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
.chat-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}
.chat-input {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 980rpx;
  padding: 0 36rpx;
  font-size: 30rpx;
  color: #1d1d1f;
}
.chat-send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 980rpx;
  font-size: 30rpx;
  font-weight: 400;
}
.chat-send-btn.active {
  background: #0071e3;
  color: #ffffff;
}
.chat-send-btn.active:active {
  background: #005bb8;
}
.chat-send-btn.disabled {
  background: #e8e8ed;
  color: #86868b;
}
