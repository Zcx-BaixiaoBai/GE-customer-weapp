/* 个人中心 — Apple 设计体系（见根目录 DESIGN.md） */

.profile-container {
  min-height: 100vh;
  background: #f5f5f7;
}

/* ========== 未登录页 ========== */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: #f5f5f7;
}
.login-logo { margin-bottom: 48rpx; }
.logo-circle {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: #000000;
  display: flex; align-items: center; justify-content: center;
}
.logo-inner {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #ffffff; box-shadow: inset 0 0 0 8rpx #000000;
}
.login-title {
  font-size: 48rpx; font-weight: 600; line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: #1d1d1f; margin-bottom: 16rpx;
}
.login-sub {
  font-size: 26rpx; color: #6e6e73; margin-bottom: 80rpx;
  text-align: center;
}
.login-btn {
  width: 100%; height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  background: #0071e3;
  color: #ffffff; font-size: 32rpx; font-weight: 400;
  border-radius: 980rpx; border: none;
  margin-bottom: 32rpx; padding: 0;
}
.login-btn:active { background: #005bb8; }
.login-btn::after { border: none; }
.login-tip { font-size: 22rpx; color: #86868b; }

/* ========== 设置引导页 ========== */
.setup-page {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  padding: 160rpx 64rpx 80rpx;
  background: #f5f5f7;
}
.setup-step-num {
  font-size: 48rpx; font-weight: 600; line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: #1d1d1f; margin-bottom: 16rpx;
}
.setup-step-desc {
  font-size: 26rpx; color: #6e6e73;
  margin-bottom: 80rpx;
}

/* 头像按钮 */
.setup-avatar-area { margin-bottom: 48rpx; }
.setup-avatar-btn {
  width: 200rpx !important; height: 200rpx !important;
  max-width: 200rpx !important; min-width: 200rpx !important;
  border-radius: 50%;
  background: #ffffff;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; padding: 0 !important; margin: 0 auto;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}
.setup-avatar-btn::after { border: none; }
.setup-avatar-img { width: 100%; height: 100%; display: block; }
.setup-avatar-empty {
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
}
.setup-avatar-plus {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #f5f5f7;
  position: relative;
}
.setup-avatar-plus::before {
  content: ''; position: absolute;
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 20rpx; height: 4rpx; background: #86868b; border-radius: 2rpx;
}
.setup-avatar-plus::after {
  content: ''; position: absolute;
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 4rpx; height: 20rpx; background: #86868b; border-radius: 2rpx;
}
.setup-avatar-label {
  font-size: 22rpx; color: #86868b;
}

/* 昵称输入 */
.setup-nick-area {
  width: 100%; margin-bottom: 80rpx;
  background: #ffffff;
  border-radius: 20rpx; padding: 0 32rpx;
}
.setup-nick-input {
  width: 100%; height: 96rpx;
  font-size: 30rpx; color: #1d1d1f;
  text-align: center;
}

/* 完成按钮：未激活=禁用态，激活=主按钮蓝 */
.setup-big-btn {
  width: 100%; height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  background: #e8e8ed;
  color: #86868b;
  font-size: 32rpx; font-weight: 400;
  border-radius: 980rpx;
  margin-bottom: 32rpx;
  transition: background 0.3s;
}
.setup-big-btn.active {
  background: #0071e3;
  color: #ffffff;
}
.setup-big-btn.active:active {
  background: #005bb8;
}

.setup-skip-link {
  font-size: 26rpx; color: #0066cc;
  padding: 16rpx 32rpx;
}

/* ========== 已登录头部（浅色 Hero 区） ========== */
.profile-header {
  background: #ffffff;
  padding: 80rpx 32rpx 64rpx;
  display: flex; flex-direction: column; align-items: center;
}
.profile-avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: #f5f5f7;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-text { font-size: 44rpx; color: #1d1d1f; font-weight: 600; }
.profile-name {
  font-size: 36rpx; font-weight: 600; line-height: 1.2;
  color: #1d1d1f; margin-bottom: 16rpx;
}
.profile-phone {
  display: flex; align-items: center; gap: 12rpx;
  background: #f5f5f7;
  padding: 10rpx 24rpx; border-radius: 980rpx;
}
.phone-num { font-size: 26rpx; color: #6e6e73; }
.phone-tag {
  font-size: 22rpx; line-height: 1;
  color: #34c759; background: rgba(52, 199, 89, 0.15);
  padding: 6rpx 14rpx; border-radius: 980rpx;
}

/* ========== 个人信息卡片 ========== */
.info-card {
  margin: 24rpx 32rpx; padding: 8rpx 36rpx;
  background: #ffffff; border-radius: 24rpx;
}
.info-title {
  font-size: 26rpx; color: #86868b; padding: 28rpx 0 8rpx;
}
.info-row {
  display: flex; align-items: center;
  padding: 28rpx 0;
}
.info-label { font-size: 30rpx; color: #1d1d1f; width: 140rpx; flex-shrink: 0; }
.info-value { font-size: 30rpx; color: #6e6e73; flex: 1; text-align: right; }
.info-input { flex: 1; text-align: right; font-size: 30rpx; color: #1d1d1f; }
.info-avatar-btn {
  width: 80rpx !important; height: 80rpx !important;
  max-width: 80rpx !important; min-width: 80rpx !important;
  border-radius: 50%;
  background: #f5f5f7; padding: 0 !important; margin: 0;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; line-height: 1; box-sizing: border-box;
}
.info-avatar-btn::after { border: none; }
.info-avatar { width: 100%; height: 100%; border-radius: 50%; display: block; }
.info-avatar-placeholder { font-size: 22rpx; color: #86868b; }

/* ========== 菜单 ========== */
.profile-menu {
  margin: 0 32rpx; background: #ffffff; border-radius: 24rpx;
  overflow: hidden;
}
.menu-item {
  display: flex; align-items: center;
  padding: 36rpx 32rpx;
}
.menu-item:active {
  background: #f5f5f7;
}
.menu-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 24rpx; }
.menu-dot.blue { background: #0071e3; }
.menu-dot.purple { background: #6e6e73; }
.menu-title { flex: 1; font-size: 30rpx; color: #1d1d1f; }
.menu-arrow { font-size: 30rpx; color: #86868b; }

/* ========== 退出登录 ========== */
.logout-btn {
  margin: 48rpx 32rpx; text-align: center;
  padding: 28rpx 0; background: #ffffff; border-radius: 24rpx;
  font-size: 30rpx; color: #ff3b30;
}
.logout-btn:active {
  background: #f5f5f7;
}
