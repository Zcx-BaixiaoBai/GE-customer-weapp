<view class="profile-container">

  <!-- 未登录：大登录按钮 -->
  <view class="login-page" wx:if="{{!isLogin}}">
    <view class="login-logo">
      <view class="logo-circle">
        <view class="logo-inner"></view>
      </view>
    </view>
    <text class="login-title">金鹰世界物业</text>
    <text class="login-sub">登录后即可使用智能问答、报修等功能</text>

    <button class="login-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">微信一键登录</button>
    <text class="login-tip">将获取你的手机号用于报修联系</text>
  </view>

  <!-- 已登录但需要设置头像/昵称：全屏引导 -->
  <view class="setup-page" wx:if="{{isLogin && needSetupProfile}}">
    <view class="setup-step-num">完善个人信息</view>
    <text class="setup-step-desc">点击下方授权微信头像和昵称</text>

    <!-- 头像：原生button open-type="chooseAvatar" -->
    <view class="setup-avatar-area">
      <button class="setup-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="setup-avatar-img" mode="aspectFill" />
        <view wx:else class="setup-avatar-empty">
          <view class="setup-avatar-plus"></view>
          <text class="setup-avatar-label">授权头像</text>
        </view>
      </button>
    </view>

    <!-- 昵称：原生input type="nickname" -->
    <view class="setup-nick-area">
      <input class="setup-nick-input" type="nickname" placeholder="点击授权微信昵称"
             value="{{nickName}}" bindinput="onNickNameInput" bindblur="onNickNameBlur" />
    </view>

    <!-- 完成 -->
    <view class="setup-big-btn {{avatarUrl && nickName ? 'active' : ''}}" bindtap="onSetupComplete">完成</view>

    <view class="setup-skip-link" bindtap="skipSetup">
      <text>跳过，稍后设置</text>
    </view>
  </view>

  <!-- 已登录且已设置完毕 -->
  <view wx:if="{{isLogin && !needSetupProfile}}">
    <view class="profile-header">
      <view class="profile-avatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <text wx:else class="avatar-text">{{nickName ? nickName[0] : '用'}}</text>
      </view>
      <view class="profile-name">{{nickName || '金鹰用户'}}</view>
      <view class="profile-phone" wx:if="{{phone}}">
        <text class="phone-num">{{phone}}</text>
        <text class="phone-tag">已验证</text>
      </view>
    </view>

    <!-- 租户状态 -->
    <view class="info-card" wx:if="{{registered}}">
      <view class="info-title">我的租户</view>
      <view class="info-row">
        <text class="info-label">所属租户</text>
        <text class="info-value">{{tenantName || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">角色</text>
        <text class="info-value">{{isManager ? '店长' : '员工'}}</text>
      </view>
    </view>
    <view class="info-card" wx:if="{{isLogin && !registered && !checkingTenant}}" bindtap="goTenantSelect">
      <view class="info-title" style="color:#0071e3">未选择租户，点击选择 ›</view>
    </view>

    <view class="info-card">
      <view class="info-title">个人信息</view>
      <view class="info-row">
        <text class="info-label">头像</text>
        <button class="info-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="info-avatar" mode="aspectFill" />
          <text wx:else class="info-avatar-placeholder">修改</text>
        </button>
      </view>
      <view class="info-row">
        <text class="info-label">昵称</text>
        <input class="info-input" type="nickname" placeholder="点击修改昵称"
               value="{{nickName}}" bindblur="onNickNameBlur" />
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{phone}}</text>
      </view>
    </view>

    <view class="profile-menu">
      <view class="menu-item" wx:if="{{isManager}}" bindtap="goStoreManage">
        <view class="menu-dot" style="background:#ff9500"></view>
        <text class="menu-title">店长管理（本店学习）</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goTenantSelect">
        <view class="menu-dot" style="background:#34c759"></view>
        <text class="menu-title">{{registered ? '切换租户' : '选择租户'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goRepairList">
        <view class="menu-dot blue"></view>
        <text class="menu-title">我的报修</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goHistory">
        <view class="menu-dot purple"></view>
        <text class="menu-title">问答历史</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goCertificates">
        <view class="menu-dot" style="background:#af52de"></view>
        <text class="menu-title">我的证书</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goPrivacy">
        <view class="menu-dot" style="background:#86868b"></view>
        <text class="menu-title">隐私政策</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>

</view>
