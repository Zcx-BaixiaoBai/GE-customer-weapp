<view class="ts-container">
  <view class="ts-header">
    <text class="ts-title">选择您的租户</text>
    <text class="ts-sub">按架构浏览，点击租户加入；或新建租户成为店长</text>
  </view>

  <view class="seg">
    <view class="seg-item {{mode === 'join' ? 'active' : ''}}" bindtap="switchMode" data-mode="join">加入已有</view>
    <view class="seg-item {{mode === 'create' ? 'active' : ''}}" bindtap="switchMode" data-mode="create">新建租户</view>
  </view>

  <!-- 树状架构 -->
  <view wx:if="{{mode === 'join'}}">
    <view wx:if="{{flatList.length === 0}}" class="empty">暂无架构数据，请切换到「新建租户」</view>
    <view wx:else class="tree-box">
      <view class="tree-node" wx:for="{{flatList}}" wx:key="id"
            style="padding-left:{{24 + item.depth * 32}}rpx"
            bindtap="onNodeTap" data-id="{{item.id}}">
        <text class="tree-arrow {{item.expanded ? 'open' : ''}}">{{item.hasChildren ? (item.expanded ? '▾' : '▸') : '•'}}</text>
        <text class="type-badge t-{{item.nodeType}}">{{item.typeLabel}}</text>
        <text class="node-name {{item.isTenant ? 'is-tenant' : ''}}">{{item.name}}</text>
        <text wx:if="{{item.code}}" class="node-code">{{item.code}}</text>
        <text wx:if="{{item.isTenant}}" class="join-tag">加入 ›</text>
      </view>
    </view>
  </view>

  <!-- 新建租户 -->
  <view wx:if="{{mode === 'create'}}" class="create-box">
    <view class="field">
      <text class="field-label">租户名称</text>
      <input class="field-input" placeholder="如：某品牌店铺" value="{{newTenantName}}" bindinput="onNameInput" />
    </view>
    <view class="create-tip">新建后您将成为该租户的店长，可查看本店全员学习情况</view>
    <button class="create-btn {{newTenantName ? 'active' : ''}}" bindtap="createTenant"
            disabled="{{submitting}}">{{submitting ? '提交中…' : '创建并成为店长'}}</button>
  </view>
</view>
