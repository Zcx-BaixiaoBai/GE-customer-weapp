/* 首页 — 编辑式页首 + 双列特色卡 + iOS 分组列表（动效见 app.wxss 令牌） */
.index-container {
  min-height: 100vh;
  background: #f5f5f7;
}

/* ========== 页首：问候 + 日期（顶部大留白） ========== */
.hero {
  padding: 152rpx 40rpx 56rpx;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #86868b;
  display: block;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -1rpx;
  line-height: 1.15;
  display: block;
}

.hero-sub {
  font-size: 26rpx;
  color: #6e6e73;
  margin-top: 16rpx;
  display: block;
}

/* ========== 特色服务：双列等宽卡（微阴影浮起，页面主角） ========== */
.featured-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
}

.featured-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
}

.featured-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.featured-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.25;
  margin-top: 24rpx;
}

.featured-desc {
  font-size: 22rpx;
  color: #86868b;
  line-height: 1.4;
  margin-top: 8rpx;
}

/* 右下角圆形箭头：可交互暗示 */
.featured-arrow {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.featured-card:active .featured-arrow {
  background: #e8e8ed;
}

.featured-arrow-icon {
  font-size: 24rpx;
  color: #6e6e73;
  line-height: 1;
}

/* ========== 图标 chip：iOS 设置风格彩色方块 ========== */
.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.featured-card:active .chip {
  transform: scale(1.06);
}

.chip-lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
}

.chip-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
}

/* ========== 区块标题 ========== */
.section-header {
  padding: 40rpx 40rpx 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #86868b;
  letter-spacing: 1rpx;
}

/* ========== 更多服务：iOS 分组列表 ========== */
.group-list {
  margin: 0 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
}

.group-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  position: relative;
  transition: background 0.15s ease;
}

.group-row:active {
  background: #f5f5f7;
}

/* 行间细线：左缩进对齐文字 */
.group-row::after {
  content: '';
  position: absolute;
  left: 132rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #d2d2d7;
  transform: scaleY(0.5);
}

.group-row.last::after {
  display: none;
}

.group-text {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.group-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #1d1d1f;
  line-height: 1.3;
}

.group-desc {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.chevron {
  font-size: 44rpx;
  color: #c7c7cc;
  font-weight: 400;
  margin-left: 16rpx;
  line-height: 1;
  transition: transform 0.2s ease, color 0.2s ease;
}

/* 按压行时 chevron 轻推：交互回应感 */
.group-row:active .chevron {
  transform: translateX(6rpx);
  color: #86868b;
}

.footer-tip {
  text-align: center;
  padding: 56rpx 32rpx;
  font-size: 22rpx;
  color: #86868b;
}

/* ========== 通用图标（CSS 绘制的线性图标，白色） ========== */
.icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.icon-sm {
  transform: scale(0.78);
}

.icon-shape {
  width: 100%;
  height: 100%;
  position: relative;
  box-sizing: border-box;
}

/* 智能问答 - 对话气泡 */
.icon-chat .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
}
.icon-chat .icon-shape::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 24rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 4rpx;
}
.icon-chat .icon-shape::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 32rpx;
  width: 16rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 4rpx;
}

/* 智能报修 - 扳手 */
.icon-repair .icon-shape {
  background: transparent;
}
.icon-repair .icon-shape::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 12rpx;
  background: currentColor;
  border-radius: 6rpx;
  transform: translate(-50%, -50%) rotate(45deg);
}
.icon-repair .icon-shape::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-left: none;
  border-radius: 0 8rpx 0 0;
}

/* 我的报修 - 清单 */
.icon-list .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}
.icon-list .icon-shape::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  box-shadow: 0 16rpx 0 currentColor;
}
.icon-list .icon-shape::after {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 16rpx;
  width: 18rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
  box-shadow: 0 16rpx 0 currentColor;
}

/* 培训学习 - 书本 */
.icon-training .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 4rpx 8rpx 8rpx 4rpx;
}
.icon-training .icon-shape::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 50%;
  width: 12rpx;
  height: 100%;
  background: currentColor;
  border-radius: 6rpx;
  transform: translateY(-50%);
}
.icon-training .icon-shape::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 40%;
  width: 16rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
  box-shadow: 0 10rpx 0 currentColor;
  transform: translateX(-50%);
}

/* 在线考试 - 试卷勾 */
.icon-exam .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}
.icon-exam .icon-shape::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 20rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
  box-shadow: 0 10rpx 0 currentColor, 0 20rpx 0 currentColor;
}
.icon-exam .icon-shape::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 6rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 50%;
  box-shadow: 0 10rpx 0 currentColor, 0 20rpx 0 currentColor;
}

/* 个人中心 - 用户 */
.icon-profile .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}
.icon-profile .icon-shape::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 18rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}
.icon-profile .icon-shape::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 32rpx;
  height: 16rpx;
  background: currentColor;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateX(-50%);
}
