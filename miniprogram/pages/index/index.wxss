.index-container {
  min-height: 100vh;
}

.hero {
  height: 320rpx;
  position: relative;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #3370ff 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 12rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 24rpx;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
}

.feature-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.feature-card:active {
  transform: scale(0.96);
}

.feature-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.feature-icon-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通用图标容器 */
.icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}
.icon-shape {
  width: 100%;
  height: 100%;
  position: relative;
  box-sizing: border-box;
}

/* 智能问答 - 对话气泡 */
.icon-chat .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
}
.icon-chat .icon-shape::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 24rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 4rpx;
}
.icon-chat .icon-shape::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 32rpx;
  width: 16rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 4rpx;
}

/* 智能报修 - 扳手 */
.icon-repair .icon-shape {
  background: transparent;
}
.icon-repair .icon-shape::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 12rpx;
  background: currentColor;
  border-radius: 6rpx;
  transform: translate(-50%, -50%) rotate(45deg);
}
.icon-repair .icon-shape::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-left: none;
  border-radius: 0 8rpx 0 0;
}

/* 我的报修 - 清单 */
.icon-list .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}
.icon-list .icon-shape::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
  box-shadow: 0 16rpx 0 currentColor;
}
.icon-list .icon-shape::after {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 16rpx;
  width: 18rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
  box-shadow: 0 16rpx 0 currentColor;
}

/* 个人中心 - 用户 */
.icon-profile .icon-shape {
  background: transparent;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}
.icon-profile .icon-shape::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 18rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}
.icon-profile .icon-shape::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 32rpx;
  height: 16rpx;
  background: currentColor;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateX(-50%);
}

.feature-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8a95a7;
  text-align: center;
}

.footer-tip {
  text-align: center;
  padding: 48rpx 32rpx;
  font-size: 24rpx;
  color: #c4cbd7;
}
